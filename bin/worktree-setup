#!/usr/bin/env bash
# Prepare a fresh git worktree so it can run on its own. Safe to re-run. Works from any tool (Orca, worktrunk, by hand).
#
#   1. Copies the untracked local files (secrets, members, Bots) a worktree lacks, from the main checkout, never overwriting.
#   2. Gives the worktree its own ports, derived from its branch name, written to .env.local.
#   3. Installs dependencies if they are missing.
#
# Bots come from the main checkout's data/bots, or from examples/bots when it has none.
# The conversation database is deliberately NOT copied: each worktree starts with its own data/.
set -euo pipefail

top=$(git rev-parse --show-toplevel)
main=$(git worktree list --porcelain | awk '/^worktree /{print substr($0, 10); exit}')
cd "$top"

if [ "$top" = "$main" ]; then
	echo "worktree-setup: this is the main checkout; nothing to do."
	exit 0
fi

copy_if_missing() { # <relative path> <mode>
	local rel=$1 mode=$2
	if [ -e "$rel" ]; then echo "  keep   $rel (already here)"; return; fi
	if [ ! -e "$main/$rel" ]; then echo "  skip   $rel (not in the main checkout)"; return; fi
	mkdir -p "$(dirname "$rel")"
	cp "$main/$rel" "$rel"
	chmod "$mode" "$rel"
	echo "  copy   $rel"
}

echo "worktree-setup: $top (main checkout: $main)"
copy_if_missing mise.local.toml 600
copy_if_missing data/members.json 644

# Bots: take the main checkout's live Bots when it has any. Otherwise seed the Bots that belong to nobody in particular
# from the examples (a personal example names a Member who may not exist here, so it is left out).
if [ -d "$main/data/bots" ] && compgen -G "$main/data/bots/*.json" >/dev/null; then
	for f in "$main"/data/bots/*.json; do copy_if_missing "data/bots/$(basename "$f")" 644; done
elif [ ! -d data/bots ]; then
	mkdir -p data/bots
	for f in examples/bots/*.json; do
		if grep -q '"kind": "personal"' "$f"; then continue; fi
		cp "$f" "data/bots/$(basename "$f")"
		echo "  seed   data/bots/$(basename "$f") (from examples)"
	done
fi

# Two ports per worktree, from a hash of the branch name: the server on an even port, the web app on the next.
# Same branch, same ports, every time. Two branches can collide in theory (1 in 5000); change the branch name if so.
branch=$(git branch --show-current)
branch=${branch:-$(basename "$top")}
hash=$(printf '%s' "$branch" | cksum | cut -d' ' -f1)
server_port=$((10000 + (hash % 5000) * 2))
web_port=$((server_port + 1))
cat > .env.local <<ENV
# Generated by bin/worktree-setup for branch "$branch". Ignored by git; safe to regenerate.
PORT=$server_port
HAMKEY_WEB_PORT=$web_port
ENV
echo "  ports  server $server_port, web $web_port (.env.local)"

command -v mise >/dev/null 2>&1 && mise trust --quiet 2>/dev/null || true
if [ ! -d node_modules ]; then
	echo "  install npm ci"
	npm ci --no-audit --no-fund
else
	echo "  keep   node_modules (already here)"
fi
echo "worktree-setup: done. Run: mise run dev"
